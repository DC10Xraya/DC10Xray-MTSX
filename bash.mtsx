// bash.mtsx dev1.9
// https://github.com/DC10Xraya/DC10Xray-MTSX
{
    name: ["Bash", ".bash", ".bashrc", ".bash_profile", ".bash_logout"]

    styles: [
        "keyword",     #1033AC, #C17C41
        "keyword2",    #800000, #AE8ABE
        "funDefName",  #C57633, #F6C87B
        "funName",     #3071B9, #C17C41
        "variable",    #466D7B, #8195B7
        "shebang",     #000000, #F0F0F0, @BU
        "operator",    #205060, #508090
        "strEscape",   #D17B2D, #F0C674
        "ansiEscape",  #AF5FD7, #D7AFFF
    ]

    comment: {startsWith: "#", addToContains: false}
    bracketPairs: ["{}", "[]", "()"]

    defines: [
        "funNameRegex": /[.\-\/@#:\w]+/
        "funNameRegexOrEmpty": /(?:/ + include("funNameRegex") + /)?/

        // ---- 算术表达式 ----
        "arithmeticExpChildren": [
            {include: "arithmeticExpGroup"}
            {match: /(?i)\b(0x[0-9A-F]+|0[0-7]+|[1-9][0-9]*#[0-9a-z]+|[0-9]+)\b/, 0: "number"}
            {match: /\$[a-zA-Z_]\w*/, 0: "variable"}
            {match: /[a-zA-Z_]\w*/, 0: "variable"}
            {match: /[+\-*\/%&|^~!]=?|<<=?|>>=?|\*\*?|\+\+|--|&&|\|\||,/, 0: "operator"}
        ]
        "arithmeticExpGroup": {
            start: {match: /\(/}
            end: {match: /\)/}
            contains: [{include: "arithmeticExpChildren"}]
        }

        // ---- 参数扩展操作符 ----
        "paramExpOperators": [
            {match: /:([-+?=])?/, 0: "operator"}
            {match: /(?<![#%])[#%](?![#%])/, 0: "operator"}
            {match: /##?|%%?/, 0: "operator"}
            {match: /\/\/?[#%]?/, 0: "operator"}
            {match: /[,^]{1,2}/, 0: "operator"}
            {match: /\[[@*]\]|\[\d+\]/, 0: "keyword"}
            {match: /!\s*(?=\w)/, 0: "operator"}
        ]

        // ---- 变量扩展 & 命令替换 ----
        "exp": [
            {match: /\$(?:[a-zA-Z_]\w*|[0-9#*@?$!_\-])/, 0: "variable"}
            {
                style: "variable"
                start: {match: /(\$)\{/, 1: "keyword"}
                end: {match: /\}/}
                contains: [
                    {include: "exp"}
                    {include: "str"}
                    {include: "num"}
                    {include: "paramExpOperators"}
                ]
            }
            {
                style: "default"
                start: {match: /\$\(\(/, 0: "keyword"}
                end: {match: /\)\)/, 0: "keyword"}
                contains: [{include: "arithmeticExpGroup"}]
            }
            {
                style: "default"
                start: {match: /(\$)(\()/, 1: "keyword", 2: "funName"}
                end: {match: /\)/, 0: "funName"}
                contains: [
                    {include: "exp"}
                    {include: "str"}
                    {include: "num"}
                    {include: "procSub"}
                    {match: /(?m)(?:^|[;{|&!(]|\|\||&&)[ \t]*(/ + include("funNameRegex") + /)\b(?![ \t]*\+?=)/, 1: "funName"}
                    {match: /</, 0: "operator"}
                ]
            }
            {
                style: "default"
                start: {match: /`/ + include("funNameRegexOrEmpty"), 0: "funName"}
                end: {match: /`/, 0: "funName"}
                contains: [
                    {include: "exp"}
                    {include: "str"}
                    {include: "num"}
                    {include: "procSub"}
                    {match: /(?m)(?:^|[;{|&!(]|\|\||&&)[ \t]*(/ + include("funNameRegex") + /)\b(?![ \t]*\+?=)/, 1: "funName"}
                ]
            }
        ]

        // ---- 字符串（含 ANSI 转义独立识别） ----
        "str": [
            {match: /\\033\[[0-9;]*m/, 0: "ansiEscape"}
            {match: /\\./, 0: "strEscape"}

            {
                style: "string"
                start: {match: /"/}
                end: {match: /"/}
                contains: [
                    {match: /\\033\[[0-9;]*m/, 0: "ansiEscape"}
                    {match: /\\./, 0: "strEscape"}
                    {include: "exp"}
                ]
            }
            {
                style: "string"
                start: {match: /\$"/}
                end: {match: /"/}
                contains: [
                    {match: /\\033\[[0-9;]*m/, 0: "ansiEscape"}
                    {match: /\\./, 0: "strEscape"}
                    {include: "exp"}
                ]
            }
            {
                style: "string"
                start: {match: /\$'/}
                end: {match: /'/}
                contains: [
                    {match: /\\033\[[0-9;]*m/, 0: "ansiEscape"}
                    {match: /\\(?:[abeEfnrtv\\'"?]|[0-7]{1,3}|u[\da-fA-F]{1,4}|U[\da-fA-F]{1,8}|c[^'])/, 0: "strEscape"}
                    {match: /\\./, 0: "error"}
                ]
            }
            {
                style: "string"
                start: {match: /'/}
                end: {match: /'/}
            }
        ]

        // ---- 数字 ----
        "num": {match: /(?<![.\w])\b\d+\b(?![.\w])/, 0: "number"}

        // ---- 进程替换 ----
        "procSub": {
            style: "default"
            start: {match: /(?:<|>)(\()/, 1: "operator"}
            end: {match: /\)/, 0: "operator"}
            contains: [
                {include: "exp"}
                {include: "str"}
                {include: "num"}
                {match: /(?m)(?:^|[;{|&!(]|\|\||&&)[ \t]*(/ + include("funNameRegex") + /)\b(?![ \t]*\+?=)/, 1: "funName"}
            ]
        }

        // ---- Here Document ----
        "hereDoc": [
            {
                match: /(?s) <<[ \t]*(?:-[ \t]*)?/ +
                       /(?:\\\n[ \t]*)?/ +
                       /\\([^\s'"`$\\|&;<>(){}\[\]]+)[ \t]*\n/ +
                       /(.{0,50000}?)/ +
                       /\n(\1)(?m)(?=$)/
                1: "keyword"
                2: "string"
                3: "keyword"
            }
            {
                match: /(?s) <<[ \t]*(?:-[ \t]*)?/ +
                       /(?:\\\n[ \t]*)?/ +
                       /(['"])(.+?)\1[ \t]*\n/ +
                       /(.{0,50000}?)/ +
                       /\n(\2)(?m)(?=$)/
                2: "keyword"
                3: "string"
                4: "keyword"
            }
            {
                match: /(?s) <<[ \t]*(?:-[ \t]*)?/ +
                       /(?:\\\n[ \t]*)?/ +
                       /([^\s'"`$\\|&;<>(){}\[\]]+)[ \t]*\n/ +
                       /(.{0,50000}?)/ +
                       /\n(\1)(?m)(?=$)/
                1: "keyword"
                2: "string"
                2: {include: "exp"}
                3: "keyword"
            }
        ]
    ]

    // ---- 主规则 ----
    contains: [
        {match: /(?s)^\u007fELF.+$/, 0: "default"}
        {match: /^#!.*/, 0: "shebang"}

        // ---- 函数定义（精确匹配，优先） ----
        {
            match: /(?m)^[ \t]*(function\s+)?([\w\-]+)\s*\(\s*\)\s*\{/,
            1: "keyword",
            2: "funDefName"
        }
        {
            match: /(?m)^[ \t]*(function\s+)([\w\-]+)\s*\{/,
            1: "keyword",
            2: "funDefName"
        }

        // 注释
        {match: /(?m)^[ \t]*#[ \t]*(TODO|FIXME|XXX|HACK)\b.*$/, 0: "meta"}
        {match: /(?m)^[ \t]*#.*$/, 0: "comment"}
        {match: /(?m)(?<=[ \t])#.*$/, 0: "comment"}

        // 赋值（普通和数组）
        {
            match: /(?m)(?:^|[;|&{(]|\|\||&&)[ \t]*([a-zA-Z_]\w*)[ \t]*(\+?=)(?![ \t]*[()])/,
            1: "variable", 2: "operator"
        }
        {
            style: "default"
            start: {match: /(?m)(?:^|[;|&{(]|\|\||&&)[ \t]*([a-zA-Z_]\w*)[ \t]*\(/, 1: "variable"}
            end: {match: /\)/}
            contains: [
                {include: "exp"}
                {include: "str"}
                {include: "num"}
            ]
        }

        // 基础元素
        {include: "exp"}
        {include: "str"}
        {include: "num"}
        {include: "hereDoc"}

        // ---- 命令名/函数名（提前，确保在重定向运算符之前） ----
        // 匹配控制符后的命令
        {match: /(?m)(?:^|[;{|&!(]|\|\||&&)[ \t]*(/ + include("funNameRegex") + /)\b(?![ \t]*\+?=)/, 1: "funName"}
        // 匹配行首命令
        {match: /(?m)^[ \t]*(/ + include("funNameRegex") + /)\b(?![ \t]*\+?=)/, 1: "funName"}

        // Here String
        {match: /<<<\s*("[^"]*"|'[^']*'|\S+)/, 0: "keyword", 1: "string"}
        // 进程替换
        {include: "procSub"}

        // 重定向运算符（包括管道 |，现在在命令名之后，不会干扰）
        {match: /[0-9]*\s*(<|<<|<<<|<>|>>|>|&>|>&|&>>|>>!|>!|&>!|[|]&|[|])/, 0: "operator"}

        // 条件测试 [[ ]]
        {
            style: "keyword"
            start: {match: /\[\[/}
            end: {match: /\]\]/}
            contains: [
                {include: "exp"}
                {include: "str"}
                {include: "num"}
                {match: /(?:-[a-zA-Z]{1,3}|==?|!=|<=?|>=?|=~|&&|\|\|)/, 0: "operator"}
                {match: /[<>=]/, 0: "operator"}
            ]
        }

        // 算术运算 (( ))
        {
            style: "keyword"
            start: {match: /\(\(/}
            end: {match: /\)\)/}
            contains: [{include: "arithmeticExpChildren"}]
        }

        // : 命令 + here doc (当作注释)
        {match: /(?sm)^[ \t]*:[ \t]*<<\s*-?\s*/ + include("funNameRegex") + /\b(.+?)(?-m)(\b\1\b|$)/, 0: "comment"}
        // case 结束符
        {match: /;;?&?|;&|;;&/, 0: "keyword"}

        // 关键字（流程控制）
        {match: "\b(?:" + keywordsToRegex(
            "if then else elif fi for while in do done case esac"
            "until select time function coproc"
        ) + ")\b", 0: "keyword"}

        // 内建命令
        {match: "\b(?:" + keywordsToRegex(
            "alias bg bind break builtin caller cd command compgen complete compopt continue"
            "declare dirs disown echo enable eval exec exit export false fc fg"
            "getopts hash help history jobs kill let local logout mapfile popd"
            "printf pushd pwd read readarray return set shift shopt source"
            "suspend test times trap true type typeset ulimit umask unalias unset wait"
        ) + ")\b", 0: "keyword2"}
    ]
}